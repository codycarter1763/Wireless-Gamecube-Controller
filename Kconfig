# Bigger stacks than Zephyr's defaults: the stats printout (snprintf +
# several long printk calls) overflowed the 1 KB main stack, which trips the
# stack guard and halts the CPU. These must come before Kconfig.zephyr.
config MAIN_STACK_SIZE
	default 4096

config SYSTEM_WORKQUEUE_STACK_SIZE
	default 2048

source "Kconfig.zephyr"

menu "Wireless GameCube controller"

# Pull in everything the app needs from Kconfig itself, so the build works
# even if prj.conf is not picked up.
config APP_ESB_LINK
	bool
	default y
	select GPIO
	select CLOCK_CONTROL
	select ESB
	# The receiver lets ESB keep the HF crystal on. The controller manages
	# it itself so it can switch it off between sends while dozing.
	select ESB_CLOCK_INIT if APP_ROLE_PRX
	select POWEROFF if APP_ROLE_PTX

choice APP_ROLE
	prompt "Board role"
	default APP_ROLE_PTX

config APP_ROLE_PTX
	bool "PTX - controller board (reads the real pad, sends inputs)"

config APP_ROLE_PRX
	bool "PRX - receiver board (plugs into the console)"

endchoice

config GC_DATA_PIN
	int "Joybus data pin (P0.x)"
	default 20
	range 0 31
	help
	  GC data line (pin 2 on the plug), on both boards.
	  Controller board: needs an external 1k pull-up to 3.3V.
	  Receiver board: no pull-up; the console provides it.
	  Default P0.20 = pin D3 on Pro Micro nRF52840 boards.
	  Port 0 only. Avoid P0.09/P0.10 (NFC pins).

config GC_RX_NO_SLEEP
	bool "Receiver: never let the CPU sleep"
	default y
	depends on APP_ROLE_PRX
	help
	  Runs a lowest-priority busy loop so the CPU never enters WFI idle.
	  Waking from idle delays the Joybus command ISR by several us, which
	  is enough to miss the first console bits. Costs a few mA, which
	  doesn't matter on the USB/console-powered receiver.

config APP_POLL_INTERVAL_US
	int "Pad poll interval while active (us)"
	default 1000
	depends on APP_ROLE_PTX
	help
	  How often the controller board polls the pad while you're playing.
	  One poll + send takes about 800 us, so keep this at 1000 or above.
	  2000 roughly halves the polling cost for at most 1 ms more lag.

menu "Controller power saving"
	depends on APP_ROLE_PTX

config APP_POLL_SLOW_US
	int "Pad poll interval while active but nothing is changing (us)"
	default 4000
	help
	  Adaptive poll rate: poll at APP_POLL_INTERVAL_US while the input is
	  changing, and drop to this rate after APP_FAST_HOLD_MS with no
	  change. The first change seen switches straight back to the fast
	  rate, so only that first change waits up to this interval (4 ms by
	  default, well under one 16.7 ms frame). Each poll keeps the CPU busy
	  for ~370 us, so 4000 cuts idle-hands polling cost by ~75%.
	  Set equal to APP_POLL_INTERVAL_US to always poll fast.

config APP_FAST_HOLD_MS
	int "Stay at the fast poll rate this long after the last change (ms)"
	default 100

config APP_FAST_THRESH
	int "Stick/trigger movement that selects the fast rate"
	default 3
	range 1 20
	help
	  Button changes always select the fast rate. Analog values are
	  compared with their value at the last real change, so this must be
	  larger than the sensor noise's full range: 3 for a stick that wobbles
	  +-1 at rest, 5 for a worn one that wobbles +-2. Too low and a
	  resting pad stays at 1 kHz.

config APP_KEEPALIVE_MS
	int "Send at least every N ms, even if nothing changed"
	default 20
	help
	  Input is only sent when it changes, plus this keepalive. Must stay
	  well under the receiver's APP_RX_STALE_MS (250 ms), after which the
	  console sees a neutral controller: with 20 ms, about a dozen packets
	  in a row must be lost before control drops.

config APP_ANALOG_DEADBAND
	int "Stick/trigger change that counts as new input"
	default 1
	range 1 20
	help
	  1 sends every analog change (most precise). 2-3 ignores sensor noise
	  on worn sticks, so fewer packets are sent while the pad sits still.

config APP_ACTIVITY_THRESH
	int "Stick/trigger movement that counts as 'someone is playing'"
	default 12
	help
	  Button presses always count. Analog changes smaller than this
	  (sensor noise, a resting thumb) don't reset the idle timers.

config APP_DOZE_S
	int "Seconds without activity before dozing (0 = never)"
	default 60
	help
	  Doze: poll the pad at a low rate, HF crystal off between sends,
	  status LED off. Any activity switches straight back to full rate.

config APP_DOZE_POLL_MS
	int "Pad poll interval while dozing (ms)"
	default 16

config APP_SLEEP_MIN
	int "Minutes without activity before powering off (0 = never)"
	default 10
	help
	  Power off: pad power (VCC) cut, nRF in System OFF (~a few uA).
	  Wake with one press of the reset button, or GC_WAKE_PIN.

config APP_LINK_LOSS_MS
	int "No acknowledged packet for this long -> link counts as lost (ms)"
	default 1000
	help
	  While the link is lost, the controller stops sending on every input
	  change and only probes every APP_LINK_PROBE_MS, until a probe is
	  acknowledged. Time-based, so a burst of failures on a lossy link
	  doesn't switch to probing while packets are still getting through.

config APP_LINK_PROBE_MS
	int "Probe interval while the link is lost (ms)"
	default 100

config APP_LINK_LOST_SLEEP_MIN
	int "Minutes without a receiver before powering off (0 = never)"
	default 5
	help
	  Powers off even while buttons are being pressed: without a receiver
	  the controller can't do anything useful.

config GC_VCC_CTRL_PIN
	int "VCC switch control pin (P0.x, -1 = board has none)"
	default 13
	range -1 31
	help
	  Pro Micro nRF52840 / nice!nano boards switch their VCC pin's 3.3V
	  with P0.13. The pad is powered from VCC, so turning it off cuts the
	  pad's power while the board sleeps.

config GC_VCC_ON_HIGH
	bool "VCC is on when the control pin is high"
	default y
	help
	  y: SuperMini / nice!nano v2 clones (low = VCC off).
	  n: original nice!nano v1 (high = VCC off).

config GC_WAKE_PIN
	int "Optional wake button pin (P0.x, button to GND; -1 = reset only)"
	default -1
	range -1 31

config APP_OTA_COMBO
	bool "Button combo reboots into the Bluetooth (OTA) bootloader"
	default y
	help
	  Hold L + R + Z + A (both triggers fully clicked) for APP_OTA_HOLD_MS
	  and the controller reboots into the Adafruit bootloader's OTA mode.
	  It then advertises over Bluetooth as "AdaDFU"; send it a DFU package
	  (gc_controller_ota.zip from CI) with the nRF Connect or nRF Toolbox
	  phone app. The bootloader stays in OTA mode until it's updated or
	  reset/power-cycled.

config APP_OTA_HOLD_MS
	int "How long the OTA combo must be held (ms)"
	default 5000
	depends on APP_OTA_COMBO

config APP_STATUS_LED
	bool "Status LED pulse while connected"
	default y
	help
	  A 20 ms pulse every 2 s while active. Off while dozing.

config APP_RTT_STATS
	bool "Measure radio round-trip time (keeps a 1 MHz timer running)"
	default y

endmenu

config APP_RF_CHANNEL
	int "ESB RF channel (2400 + n MHz)"
	default 76
	range 0 100
	help
	  76 = 2476 MHz: above Wi-Fi channel 11 and below BLE advertising
	  channel 39 (2480 MHz). Must match on both boards.

config APP_RETRANSMIT_DELAY_US
	int "ESB retransmit delay (us)"
	default 500
	range 435 4000
	help
	  Time between retries when no ACK arrives. ESB rejects anything below
	  435 us (esb_init() returns -EINVAL). Must match on both sides.

config APP_RETRANSMIT_COUNT
	int "ESB retransmit count"
	default 8
	range 0 15
	help
	  Extra attempts when no ACK arrives. On a lossy link (hands, body or
	  the console in the way) more retries make a big difference: with a
	  50% chance per attempt, 3 retries lose ~6% of packets, 8 lose ~0.2%.
	  Retries only happen when an attempt fails, so this costs nothing on a
	  good link.

config APP_TX_POWER
	int "Radio TX power (dBm)"
	default 8
	help
	  Valid on nRF52840: -40, -20, -16, -12, -8, -4, 0, 2, 3, 4, 5, 6, 7, 8.
	  +8 costs ~10 mA more only while actually transmitting (~90 us per
	  packet), i.e. well under 1 mA on average, and buys ~8 dB of link
	  margin. Applies to both boards (the receiver transmits the ACKs).

config APP_RX_STALE_MS
	int "Receiver: no packet for this long -> console sees neutral (ms)"
	default 250
	depends on APP_ROLE_PRX
	help
	  Safety net if the controller dies or goes out of range. Must be well
	  above the controller's keepalive (APP_KEEPALIVE_MS, 20 ms) so a few
	  lost packets in a row don't drop control.

config APP_DEBUG_PIN
	int "Debug GPIO (P0.x) for scope / logic analyzer"
	default 17
	range 0 31
	help
	  PTX: high from esb_write_payload() until TX success/fail.
	  PRX: short pulse each time a packet is received.
	  Default P0.17 (pin D2 on Pro Micro nRF52840 boards).

endmenu
